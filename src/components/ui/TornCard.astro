---
interface Props {
  rotate?: number;
  width?: string;
}

const { rotate = -1, width = '100%' } = Astro.props;
---

<div class="torn-card" style={`--rotate: ${rotate}deg; --width: ${width}`}>
  <div class="paper-corner">
    <div class="paper-corner-clip"></div>
    <div class="paper-corner-bg"></div>
  </div>
  <slot />
</div>

<style is:global>
  .torn-card {
    position: relative;
    width: var(--width);
    background: var(--color-surface);
    padding: 24px;
    box-shadow: 3px 3px 0 rgba(var(--color-text-rgb), 0.08),
                6px 6px 16px rgba(var(--color-text-rgb), 0.06);
    transform: rotate(var(--rotate));
  }

  .paper-corner {
    position: absolute;
    top: 0;
    right: 0;
    width: 40px;
    height: 40px;
  }

  .paper-corner-clip {
    position: absolute;
    top: 0;
    right: 0;
    width: 40px;
    height: 40px;
    background: var(--color-surface);
    box-shadow: -1px 1px 6px 2px rgba(var(--color-text-rgb), 0.2);
  }

  .paper-corner-bg {
    position: absolute;
    top: -50px;
    right: -46px;
    width: 40px;
    height: 40px;
    border: 40px solid transparent;
    border-bottom: 40px solid var(--color-bg);
    box-sizing: border-box;
    transform: rotate(45deg);
  }
</style>