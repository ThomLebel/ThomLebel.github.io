---

<button class="lang-switch" id="lang-switch" aria-label="Switch language">
  <span class="lang-opt" data-lang-opt="fr">FR</span>
  <span class="lang-sep">/</span>
  <span class="lang-opt" data-lang-opt="en">EN</span>
</button>

<style is:global>
  .lang-switch {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 300;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-hi);
    border-radius: 100px;
    cursor: pointer;
    font-family: 'Inconsolata', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    transition: all 0.25s ease;
    box-shadow: 2px 2px 0 var(--color-accent-dim);
  }

  .lang-switch:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-accent-dim);
  }

  .lang-sep {
    opacity: 0.3;
  }

  .lang-opt {
    transition: color 0.2s, font-weight 0.2s;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  /* La langue active est mise en valeur */
  html[lang="fr"] .lang-opt[data-lang-opt="fr"],
  html[lang="en"] .lang-opt[data-lang-opt="en"] {
    color: var(--color-accent);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .lang-switch {
      top: 12px;
      right: 12px;
      font-size: 0.65rem;
      padding: 5px 10px;
    }
  }
</style>

<script>
  const btn   = document.getElementById('lang-switch')!;
  const html  = document.documentElement;

  // ── Appliquer une langue ──────────────────────────
  function applyLang(lang: 'fr' | 'en') {
    html.lang = lang;
    localStorage.setItem('lang', lang);

    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
      const val = lang === 'en' ? el.dataset.en : el.dataset.fr;
      if (val !== undefined) el.textContent = val;
    });
  }

  // ── Init : lire localStorage ──────────────────────
  const saved = localStorage.getItem('lang') as 'fr' | 'en' | null;
  if (saved && saved !== 'fr') applyLang(saved);

  // ── Toggle au clic ────────────────────────────────
  btn.addEventListener('click', () => {
    const current = html.lang === 'en' ? 'fr' : 'en';
    applyLang(current);
  });
</script>
