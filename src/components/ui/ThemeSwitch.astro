<button class="theme-switch" id="theme-switch" aria-label="Changer de thème">
  <span class="theme-icon theme-icon-light">☀</span>
  <span class="theme-icon theme-icon-dark">☽</span>
</button>

<style is:global>
  .theme-switch {
    position: fixed;
    bottom: 32px;
    right: 32px;
    z-index: 200;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border-hi);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    transition: all 0.3s ease;
    box-shadow: 2px 2px 0 var(--color-accent-dim);
  }
  [data-theme="dark"] .theme-switch {
    border-color: var(--color-border-hi);
    box-shadow: 2px 2px 0 var(--color-accent-dim);
  }

  .theme-switch:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-accent-dim);
  }

  .theme-icon {
    position: absolute;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .theme-icon-light {
    opacity: 1;
    transform: rotate(0deg);
  }

  .theme-icon-dark {
    opacity: 0;
    transform: rotate(-90deg);
    color: var(--color-text);
  }

  [data-theme="dark"] .theme-icon-light {
    opacity: 0;
    transform: rotate(90deg);
  }

  [data-theme="dark"] .theme-icon-dark {
    opacity: 1;
    transform: rotate(0deg);
  }

  @media (max-width: 768px) {
    .theme-switch {
      width: 36px;
      height: 36px;
      bottom: 16px;
      right: 16px;
      font-size: 0.9rem;
    }
  }
</style>

<script>
  const btn = document.getElementById('theme-switch')!;
  const html = document.documentElement;

  // Applique la préférence sauvegardée
  const saved = localStorage.getItem('theme');
  if (saved) html.dataset.theme = saved;

  btn.addEventListener('click', () => {
    const isDark = html.dataset.theme === 'dark';
    html.dataset.theme = isDark ? '' : 'dark';
    localStorage.setItem('theme', html.dataset.theme);
  });
</script>