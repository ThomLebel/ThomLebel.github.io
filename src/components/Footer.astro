---
import links from '../data/links.json';
---

<footer class="footer">
  <div class="footer-inner">

    <div class="footer-brand">
      <span class="footer-name">Thomas Lebel</span>
      <span class="footer-studio">Bonaventure Studio</span>
    </div>

    <nav class="footer-links">
      <a href={links.linkedin} target="_blank" class="footer-link">LinkedIn</a>
      <a href={links.malt} target="_blank" class="footer-link">Malt</a>
      <a href={links.email} class="footer-link">Contact</a>
      <a href={links.bonaventure} target="_blank" class="footer-link">Studio</a>
    </nav>

    <p class="footer-copy">© Thomas Lebel — Tous droits réservés</p>

  </div>
</footer>

<style is:global>
  .footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--border);
  }

  .footer::before {
    content: '';
    position: absolute;
    top: -1px; left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg,
      transparent,
      var(--color-accent-dim) 30%,
      var(--color-accent-dim) 70%,
      transparent
    );
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 28px 60px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-name {
    font-family: 'Playfair Display', serif;
    font-size: 0.9rem;
    font-weight: 700;
    font-style: italic;
    color: var(--color-text);
  }

  .footer-studio {
    font-family: 'Inconsolata', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Liens centrés */
  .footer-links {
    display: flex;
    gap: 28px;
    justify-content: center;
  }

  .footer-link {
    font-family: 'Inconsolata', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
    position: relative;
  }

  .footer-link::before {
    content: '';
    position: absolute;
    bottom: -2px; left: 0;
    width: 0; height: 1px;
    background: var(--color-accent);
    transition: width 0.3s;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-link:hover::before {
    width: 100%;
  }

  /* Copyright à droite */
  .footer-copy {
    font-family: 'Inconsolata', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
    text-align: right;
  }

  /* ── RESPONSIVE ──────────────────────────────────── */
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      padding: 24px;
      text-align: center;
      gap: 16px;
    }

    .footer-links {
      flex-wrap: wrap;
      gap: 16px;
    }

    .footer-copy {
      text-align: center;
    }
  }
</style>