---
import SectionHeader from './ui/SectionHeader.astro';
import Tag from './ui/Tag.astro';

interface Service {
  num: string;
  title: string;
  tags: string[];
}

const services: Service[] = [
  {
    num: '01.',
    title: 'Intégration Web',
    tags: ['HTML5', 'CSS', 'Webflow', 'Astro'],
  },
  {
    num: '02.',
    title: 'Motion & Bannières',
    tags: ['GSAP', 'After Effects', 'HTML5 Ads'],
  },
  {
    num: '03.',
    title: 'Emailing MJML',
    tags: ['MJML', 'Actito', 'Brevo', 'Responsive'],
  },
  {
    num: '04.',
    title: 'Jeux Vidéo',
    tags: ['Godot', 'GDScript', 'Blender'],
  },
];
---

<section id="services" class="section-block services-section reveal">
  <div class="services-list">
    {services.map((service) => (
      <div class="service-line">
        <span class="service-num">{service.num}</span>
        <h3 class="service-title">{service.title}</h3>
        <div class="service-tags">
          {service.tags.map(tag => (
            <Tag text={tag} color="dim" />
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style is:global>
  .services-section {
    max-width: 100%;
    padding: 80px 60px;
  }

  .services-list {
    display: flex;
    flex-direction: column;
  }

  .service-line {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    cursor: default;
    transition: padding-left 0.3s ease;
    position: relative;
  }

  .service-line:first-child {
    border-top: 1px solid var(--border);
  }

  .service-line:hover {
    padding-left: 16px;
  }

  .service-line:hover .service-title {
    color: var(--color-accent);
  }

  .service-line:hover .service-num {
    color: var(--color-danger);
  }

  .service-num {
    font-family: 'Inconsolata', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--color-text-faint);
    min-width: 32px;
    transition: color 0.3s;
  }

  .service-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    font-style: italic;
    color: var(--color-text);
    flex: 1;
    line-height: 1;
    transition: color 0.3s;
  }

  .service-tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 200px;
    align-items: center;
  }

  /* ── RESPONSIVE ──────────────────────────────────── */
  @media (max-width: 768px) {
    .service-line {
      flex-wrap: wrap;
      gap: 12px;
    }

    .service-tags {
      justify-content: flex-start;
      max-width: 100%;
      padding-left: 56px;
    }

    .service-title {
      font-size: clamp(1.8rem, 8vw, 2.5rem);
    }
  }
</style>