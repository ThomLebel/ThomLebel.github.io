---
interface Props {
  email: {
    name: string;
    label: string;
    description: string;
    descriptionEn?: string;
    stack: string[];
  };
}

const { email } = Astro.props;
---

<li class="email-card" data-name={email.name}>
  <div class="email-preview">
    <iframe
      src={`/emails/${email.name}/index.html`}
      scrolling="no"
      tabindex="-1"
      title={email.label}
    ></iframe>
    <div class="email-overlay">
      <p class="email-cta" data-i18n="card.email.cta" data-fr="Voir le template →" data-en="View template →">Voir le template →</p>
    </div>
  </div>
  <div class="email-meta">
    <span class="email-label">{email.label}</span>
    <span class="email-desc" data-i18n={`email.${email.name}.desc`} data-fr={email.description} data-en={email.descriptionEn}>{email.description}</span>
    <div class="email-tags">
      {email.stack.map((tag, i) => (
        <span class="email-tag">
          {i > 0 && <span class="tag-sep"> · </span>}
          #{tag}
        </span>
      ))}
    </div>
  </div>
</li>

<style is:global>
  .email-card {
    border: 1px solid var(--border);
    background: var(--color-surface);
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    list-style: none;
  }

  .email-card::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 0; height: 0;
    border-style: solid;
    border-width: 0 18px 18px 0;
    border-color: transparent var(--color-bg) transparent transparent;
    z-index: 1;
  }

  .email-card:hover {
    border-color: var(--color-border-hi);
    box-shadow: 4px 4px 0 var(--color-accent-dim);
    transform: translate(-2px, -2px);
  }

  .email-preview {
    position: relative;
    height: 280px;
    overflow: hidden;
    background: #fff;
  }

  .email-preview iframe {
    width: 200%;
    height: 560px;
    transform: scale(0.5);
    transform-origin: top left;
    pointer-events: none;
    border: none;
    display: block;
  }

  .email-overlay {
    position: absolute;
    inset: 0;
    background: rgba(var(--color-bg-rgb),0.75);
    display: flex;
    align-items: flex-end;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .email-card:hover .email-overlay { opacity: 1; }

  .email-cta {
    font-family: 'Inconsolata', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-2);
  }

  .email-meta {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .email-label {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    font-style: italic;
    color: var(--color-text);
  }

  .email-desc {
    font-family: 'Inconsolata', monospace;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  .email-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .email-tag {
    font-family: 'Inconsolata', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
</style>