---
interface Props {
  site: {
    name: string;
    label: string;
    description: string;
    stack: string[];
    url: string;
    thumbs: string[];
  };
}

const { site } = Astro.props;
---

<li class="site-card">
  <a
    href={site.url}
    target="_blank"
    rel="noopener noreferrer"
    class="site-card-link"
  >
    <div class="site-thumbs">
      <img
        src={site.thumbs[0]}
        alt={`${site.label} — aperçu 1`}
        loading="lazy"
        class="site-thumb site-thumb-main"
      />
      <img
        src={site.thumbs[1]}
        alt={`${site.label} — aperçu 2`}
        loading="lazy"
        class="site-thumb site-thumb-hover"
      />
      <div class="site-overlay">
        <p class="site-cta">Voir le site →</p>
      </div>
    </div>
    <div class="site-meta">
      <div class="site-meta-top">
        <span class="site-label">{site.label}</span>
        <span class="site-arrow">↗</span>
      </div>
      <span class="site-desc">{site.description}</span>
      <div class="site-tags">
        {site.stack.map((tag, i) => (
          <span class="site-tag">
            {i > 0 && <span class="tag-sep"> · </span>}
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </a>
</li>

<style is:global>
  .site-card {
    border: 1px solid var(--border);
    background: var(--color-surface);
    transition: all 0.3s ease;
    position: relative;
    list-style: none;
  }

  .site-card::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 0; height: 0;
    border-style: solid;
    border-width: 0 18px 18px 0;
    border-color: transparent var(--color-bg) transparent transparent;
    z-index: 1;
  }

  .site-card:hover {
    border-color: var(--color-border-hi);
    box-shadow: 4px 4px 0 var(--color-accent-dim);
    transform: translate(-2px, -2px);
  }

  .site-card-link {
    display: block;
    color: inherit;
  }

  .site-thumbs {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .site-thumb {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: top;
    transition: opacity 0.4s ease;
    display: block;
  }

  .site-thumb-hover { opacity: 0; }
  .site-card:hover .site-thumb-main  { opacity: 0; }
  .site-card:hover .site-thumb-hover { opacity: 1; }

  .site-overlay {
    position: absolute;
    inset: 0;
    background: rgba(var(--color-bg-rgb),0.7);
    display: flex;
    align-items: flex-end;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .site-card:hover .site-overlay { opacity: 1; }

  .site-cta {
    font-family: 'Inconsolata', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-2);
  }

  .site-meta {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .site-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-label {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    font-style: italic;
    color: var(--color-text);
  }

  .site-arrow {
    font-family: 'Inconsolata', monospace;
    font-size: 0.9rem;
    color: var(--color-accent-dim);
    transition: color 0.2s, transform 0.2s;
  }

  .site-card:hover .site-arrow {
    color: var(--color-accent);
    transform: translate(2px, -2px);
  }

  .site-desc {
    font-family: 'Inconsolata', monospace;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  .site-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .site-tag {
    font-family: 'Inconsolata', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
</style>