---
interface Platform {
  id: string;
  label: string;
  url: string;
}

interface Props {
  game: {
    name: string;
    title: string;
    description: string;
    descriptionEn?: string;
    platforms: Platform[];
    images: string[];
    url: string;
  };
}

const { game } = Astro.props;

const platformIcons: Record<string, string> = {
  android: '▲',
  ios:     '◆',
  steam:   '⬡',
  web:     '○',
};
---

<div class="game-card">

  <!-- Carrousel -->
  <div class="carousel" id={`carousel-${game.name}`}>
    <div class="carousel-track">
      {game.images.map((img, i) => (
        <div class="carousel-slide">
          <img
            src={`/${img}`}
            alt={`${game.title} — écran ${i + 1}`}
            loading="lazy"
          />
        </div>
      ))}
    </div>
    <button class="carousel-btn carousel-prev" aria-label="Précédent">‹</button>
    <button class="carousel-btn carousel-next" aria-label="Suivant">›</button>
    <div class="carousel-dots">
      {game.images.map((_, i) => (
        <span class={`dot ${i === 0 ? 'active' : ''}`}></span>
      ))}
    </div>
  </div>

  <!-- Infos -->
  <div class="game-info">
    <h3 class="game-title">{game.title}</h3>
    <p class="game-desc" data-i18n={`game.${game.name}.desc`} data-fr={game.description} data-en={game.descriptionEn}>{game.description}</p>
    <div class="game-platforms">
        {game.platforms.map(p => (
            <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                class="platform-btn"
            >
                <span class="platform-icon">{platformIcons[p.id] ?? '●'}</span>
                {p.label}
            </a>
        ))}
    </div>
    <a href={game.url} target="_blank" rel="noopener noreferrer" class="game-link" data-i18n="card.game.link" data-fr="Voir le studio →" data-en="View studio →">
      Voir le studio →
    </a>
  </div>

</div>

<script>
  // Carrousel générique — fonctionne pour toutes les instances
  document.querySelectorAll('.carousel').forEach(carousel => {
    const track = carousel.querySelector('.carousel-track') as HTMLElement;
    const slides = carousel.querySelectorAll('.carousel-slide');
    const dots = carousel.querySelectorAll('.dot');
    const prev = carousel.querySelector('.carousel-prev');
    const next = carousel.querySelector('.carousel-next');
    let current = 0;

    function goTo(index: number) {
      current = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
  });
</script>

<style is:global>
  .game-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-hi);
    position: relative;
    max-width: 360px;
    width: 100%;
    margin: 0 auto;
  }

  .game-card::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 0; height: 0;
    border-style: solid;
    border-width: 0 20px 20px 0;
    border-color: transparent var(--color-bg) transparent transparent;
    z-index: 1;
  }

  /* ── CARROUSEL ───────────────────────────────────── */
  .carousel {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--color-text-faint);
  }

  .carousel-track {
    display: flex;
    height: 100%;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .carousel-slide {
    min-width: 100%;
    height: 100%;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(var(--color-bg-rgb),0.7);
    border: 1px solid var(--border);
    color: var(--color-text);
    font-size: 1.4rem;
    width: 36px; height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    z-index: 2;
    line-height: 1;
  }

  .carousel-btn:hover { background: rgba(var(--color-bg-rgb),0.95); }
  .carousel-prev { left: 10px; }
  .carousel-next { right: 10px; }

  .carousel-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 2;
  }

  .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(var(--color-text-rgb), 0.25);
    cursor: pointer;
    transition: background 0.2s;
  }

  .dot.active { background: var(--color-accent); }

  /* ── INFOS ───────────────────────────────────────── */
  .game-info {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .game-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    font-style: italic;
    color: var(--color-text);
  }

  .game-desc {
    font-family: 'Inconsolata', monospace;
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .game-platforms {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .platform-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Inconsolata', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    background: var(--color-text-faint);
    border: 1px solid var(--border);
    padding: 6px 14px;
    text-decoration: none;
    transition: all 0.25s;
    position: relative;
  }

  .platform-btn::after {
    content: '';
    position: absolute;
    bottom: -2px; right: -2px;
    width: 100%; height: 100%;
    border: 1px solid var(--color-accent-dim);
    opacity: 0;
    z-index: -1;
    transition: opacity 0.25s;
  }

  .platform-btn:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .platform-btn:hover::after { opacity: 1; }

  .platform-icon {
    color: var(--color-accent);
    font-size: 0.5rem;
    transition: color 0.25s;
  }

  .platform-btn:hover .platform-icon { color: var(--color-bg); }

  .platform-icon {
    color: var(--color-accent);
    font-size: 0.5rem;
  }

  .game-link {
    font-family: 'Inconsolata', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-2);
    text-decoration: none;
    margin-top: 4px;
    transition: opacity 0.2s;
  }

  .game-link:hover { opacity: 0.7; }
</style>