---
interface Props {
  banner: {
    name: string;
    img: string;
    client: string;
    campagne: string;
    agence: string;
  };
}

const { banner } = Astro.props;
---

<li class="banner-card" data-name={banner.name}>
  <img
    src={banner.img}
    alt={`${banner.client} — ${banner.campagne}`}
    loading="lazy"
  />
  <div class="banner-info">
    <span class="banner-client">{banner.client}</span>
    <span class="banner-campagne">{banner.campagne}</span>
    <span class="banner-agence">{banner.agence}</span>
    <p class="banner-cta">Voir le format →</p>
  </div>
</li>

<style is:global>
  .banner-card {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid var(--border);
    aspect-ratio: 300 / 250;
    transition: all 0.3s ease;
    list-style: none;
  }

  .banner-card:hover {
    border-color: var(--color-border-hi);
    box-shadow: 4px 4px 0 var(--color-accent-dim);
    transform: translate(-2px, -2px);
  }

  .banner-card img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .banner-card:hover img {
    transform: scale(1.03);
  }

  .banner-info {
    position: absolute;
    inset: 0;
    background: rgba(var(--color-bg-rgb),0.92);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .banner-card:hover .banner-info { opacity: 1; }

  .banner-client {
    font-family: 'Playfair Display', serif;
    font-size: 0.95rem;
    font-weight: 700;
    font-style: italic;
    color: var(--color-text);
    display: block;
  }

  .banner-campagne {
    font-family: 'Inconsolata', monospace;
    font-size: 0.68rem;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    margin-top: 2px;
    display: block;
  }

  .banner-agence {
    font-family: 'Inconsolata', monospace;
    font-size: 0.6rem;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 4px;
    display: block;
  }

  .banner-cta {
    font-family: 'Inconsolata', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-2);
    margin-top: 10px;
  }
</style>