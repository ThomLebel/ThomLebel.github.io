---
import SectionTitle from '../ui/SectionTitle.astro';
import FloatingCard from './FloatingCard.astro';
import ProjectGrid from './ProjectGrid.astro';

const categories = [
  {
    category: 'bannieres',
    title: 'Bannières HTML5',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="1"/><path d="M8 21h8M12 17v4"/></svg>`,
    description: 'Bannières animées pour grands comptes — GSAP, HTML5, motion design.',
    tags: ['HTML5', 'GSAP', 'JavaScript', 'After Effects'],
    index: 0,
  },
  {
    category: 'emails',
    title: 'Emailing MJML',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
    description: 'Templates responsive — MJML, Actito, Brevo, compatibles tous clients.',
    tags: ['MJML', 'Actito', 'Brevo', 'Responsive'],
    index: 1,
  },
  {
    category: 'sites',
    title: 'Sites & Landings',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>`,
    description: 'Sites vitrines, landing pages — Webflow, Astro, intégration CMS.',
    tags: ['Webflow', 'Astro', 'CSS', 'Drupal', 'WordPress'],
    index: 2,
  },
  {
    category: 'jeux',
    title: 'Jeux Vidéo',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 12h4M8 10v4M15 11h.01M17 13h.01"/></svg>`,
    description: 'Jeux indépendants — Bonaventure Studio, Godot, mobile et web.',
    tags: ['Godot', 'GDScript', 'Blender', 'Mobile'],
    index: 3,
  },
] as const;

const titleMap: Record<string, string> = {
  bannieres: 'Bannières HTML5',
  emails:    'Emailing MJML',
  sites:     'Sites & Landings',
  jeux:      'Jeux Vidéo',
};
---

<section id="realisations" class="section-block realisations-section reveal">

  <div class="realisations-header">
    <!-- <span class="realisations-num">03</span> -->
    <SectionTitle
      title="Terrain de jeu"
      rotate={1.5}
      bg="var(--color-accent)"
      tapeColor="rgba(var(--color-accent-2-rgb), 0.4)"
      textColor="var(--color-surface)"
      fontSize="2.5rem"
      padding="10px 28px"
    />
  </div>

  <!-- Zone principale -->
  <div class="realisations-zone" id="realisations-zone">

    <!-- Cartes flottantes -->
    <div class="floating-zone" id="floating-zone">
      {categories.map(({ category, title, icon, description, tags, index }) => (
        <FloatingCard
          category={category}
          title={title}
          icon={icon}
          description={description}
          tags={tags}
          index={index}
        />
      ))}
    </div>

    <!-- Zone d'expansion -->
    <div class="expansion-zone" id="expansion-zone" aria-hidden="true">
      <button class="close-btn" id="close-btn" aria-label="Fermer">
        ← Retour
      </button>
      <div class="expansion-border" id="expansion-border"></div>
      <div class="expansion-inner" id="expansion-inner">
        <div class="grids-wrapper">
          {categories.map(({ category }) => (
            <div class="grid-panel" data-grid={category}>
              <ProjectGrid category={category} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

</section>

<style is:global>
  .realisations-section {
    min-height: 500px;
  }
  
  .realisations-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 60px;
  }

  .realisations-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 4rem;
    color: rgba(var(--color-text-rgb), 0.08);
    line-height: 1;
  }

  .realisations-title {
    font-family: 'Caveat', cursive;
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  /* ── ZONE PRINCIPALE ─────────────────────────────── */
  .realisations-zone {
    position: relative;
    display: flex;
    gap: 32px;
    align-items: flex-start;
    min-height: 500px;
  }

  /* ── CARTES FLOTTANTES ───────────────────────────── */
  .floating-zone {
    position: relative;
    width: 100%;
    flex-shrink: 0;
    height: 540px;
    transition: none;
    /* transition: width 0.4s ease, height 0.4s ease; */
  }

  .floating-zone.collapsed {
    width: 240px;
    height: 300px;
  }

  .floating-zone.hidden {
    pointer-events: none;
  }

  /* Positions des 4 cartes */
.floating-card[data-index="0"] { top: 40px; left: 0%; }
.floating-card[data-index="1"] { top: 40px; left: 26%; }
.floating-card[data-index="2"] { top: 40px; left: 52%; }
.floating-card[data-index="3"] { top: 40px; left: 76%; }
.floating-zone { height: 460px; }

  /* ── ZONE D'EXPANSION ────────────────────────────── */
  .expansion-zone {
    flex: 1;
    display: none;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .expansion-zone.active {
    display: flex;
  }

  .expansion-border {
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-border-hi);
    box-shadow: inset 0 0 0 1px rgba(var(--color-accent-rgb), 0.1);
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
  }

  .expansion-inner {
    padding: 28px;
    opacity: 0;
  }

  .close-btn {
    font-family: 'Inconsolata', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: none;
    border: 1px solid var(--color-border);
    padding: 10px 16px;
    cursor: pointer;
    align-self: flex-start;
    margin: 12px 0 12px 28px;
    opacity: 0;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .close-btn.visible { opacity: 1; }

  .close-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-dim);
    background: rgba(var(--color-accent-rgb), 0.05);
  }

  /* Grilles */
  .grids-wrapper { width: 100%; }

  .grid-panel { display: none; }

  .grid-panel.active {
    display: block;
    /* animation: fadeUp 0.4s ease both; */
  }

  .banner-card,
  .email-card,
  .site-card,
  .game-card {
    opacity: 0;
  }

  /* ── RESPONSIVE ──────────────────────────────────── */
  @media (max-width: 900px) {
    .grid-emails,
    .grid-sites,
    .grid-jeux {
      grid-template-columns: 1fr;
    }

    .grid-bannieres {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 10px;
    }

    /* Contraste des cartes sur mobile */
    .banner-card,
    .email-card,
    .site-card,
    .game-card {
      background: #fff !important;
      border: 1px solid var(--color-border-hi) !important;
      box-shadow: 2px 2px 6px rgba(var(--color-text-rgb), 0.1) !important;
    }

    /* Email preview moins haute */
    .email-preview {
      height: 200px !important;
    }

    .email-preview iframe {
      width: 150% !important;
      height: 300px !important;
      transform: scale(0.66) !important;
    }

    /* Site thumbs moins haute */
    .site-thumbs {
      height: 160px !important;
    }

    .realisations-zone {
      flex-direction: column;
    }

    .floating-zone {
      width: 100%;
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding-bottom: 16px;
    }

    .floating-zone.collapsed {
      display: none; /* cache les dossiers quand ouvert */
    }

    /* 1 dossier par ligne en mobile */
    .floating-card {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      animation: none !important;
      transform: none !important;
    }

    /* Légère rotation alternée pour l'effet posé */
    .floating-card[data-index="0"] { transform: rotate(-0.5deg) !important; }
    .floating-card[data-index="1"] { transform: rotate(0.5deg) !important; }
    .floating-card[data-index="2"] { transform: rotate(-0.5deg) !important; }
    .floating-card[data-index="3"] { transform: rotate(0.5deg) !important; }

    .expansion-zone.active {
      flex-direction: column;
    }

    .expansion-left {
      display: none; /* cache le slot dossier actif */
    }

    .expansion-content {
      width: 100%;
    }
  }
</style>

<script>
  import './realisations.ts';
</script>