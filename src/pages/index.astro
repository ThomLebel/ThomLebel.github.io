---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Realisations from '../components/realisations/Realisations.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- <Navbar /> -->
  <Hero />
  <div class="ink-rule"></div>
  <Realisations />
  <div class="ink-rule"></div>
  <Contact />
  <Footer />

  <script>
    // Overlay iframe global
    const overlay = document.createElement('div');
    overlay.id = 'iframe-overlay';
    overlay.innerHTML = `
      <div id="iframe-close">[ fermer ]</div>
      <iframe id="banner-iframe" src="" frameborder="0" scrolling="no" style="opacity:0"></iframe>
    `;
    document.body.appendChild(overlay);

    const iframe = document.getElementById('banner-iframe') as HTMLIFrameElement;

    document.getElementById('iframe-overlay')?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.id === 'iframe-overlay' || target.id === 'iframe-close') {
        overlay.classList.remove('active');
        iframe.style.opacity = '0';
        iframe.src = '';
        document.body.style.overflow = '';
      }
    });
  </script>
</Layout>